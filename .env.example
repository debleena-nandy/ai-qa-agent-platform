APP_ENV=development
QA_API_BASE_URL=
QA_API_TIMEOUT_SECONDS=10
QA_BROWSER_BASE_URL=
QA_BROWSER_TIMEOUT_MS=10000
QA_BROWSER_HEADLESS=true
QA_ARTIFACT_DIRECTORY=artifacts
QA_DATABASE_PATH=data/qa_runs.sqlite3
QA_APPROVAL_TOKEN=dev-token
QA_ALLOW_PRIVATE_TARGETS=true
BROWSER_ENABLED=false
# LLM (mandatory) - CPU only
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=3072
LLM_TIMEOUT_SECONDS=300
LLM_CHECK_ON_STARTUP=true
RULE_BASED_FALLBACK=true
TEST_DESIGN_TARGET_COUNT=10-12
TEST_DESIGN_MIN_SCENARIOS=8
OLLAMA_BASE_URL=http://localhost:11434 # Local (non-Docker) runs: OLLAMA_BASE_URL=http://localhost:11434

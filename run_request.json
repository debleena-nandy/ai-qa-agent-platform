{
  "requirement": "As a customer, I want to place an order to buy a toy\nAcceptance criteria:\n- Customer can order at most 5 units per toy",
  "scenarios": [
    {
      "id": "TC-001",
      "title": "Order 2 units of an in-stock toy",
      "type": "api",
      "priority": "high",
      "preconditions": [],
      "steps": [
        "POST /orders with product toy-001 and quantity 2"
      ],
      "expected_result": "201 with status confirmed",
      "criterion_ids": [
        "AC-001"
      ],
      "api_actions": [
        {
          "method": "POST",
          "path": "/orders",
          "headers": {
            "Authorization": "Bearer demo-customer-token"
          },
          "json_body": {
            "product_id": "toy-001",
            "quantity": 2
          },
          "assertions": [
            {
              "type": "status_code",
              "expected": 201,
              "json_path": null
            },
            {
              "type": "json_equals",
              "expected": "confirmed",
              "json_path": "status"
            }
          ],
          "capture": {}
        }
      ],
